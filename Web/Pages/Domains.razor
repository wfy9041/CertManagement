@page "/domains"
@attribute [Authorize]
@inject DomainService Service
@inject DnsProviderService Providers
@inject CertificateService Certificates
@inject NavigationManager Navigation
@using DomainEntity = CertManagement.Domain.Domain

<PageTitle>域名管理</PageTitle>
<div class="page-heading"><div><p class="eyebrow">域名服务</p><h2>域名管理</h2><p class="subtitle">配置申请域名、验证方式与自动续期策略</p></div></div>
<EditForm Model="form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="form-grid"><label>主域名<input @bind="form.PrimaryDomain" placeholder="example.com 或 *.example.com" /><span class="field-help">支持单个域名或通配符域名。</span></label><label>SAN（每行一个）<textarea @bind="form.Sans" placeholder="例如：www.example.com"></textarea><span class="field-help">填写需要包含在同一张证书中的额外域名，每行填写一个。</span></label><label>验证方式<select @bind="form.ChallengeType"><option value="Http01">HTTP-01</option><option value="Dns01">DNS-01</option></select><span class="field-help">通配符域名必须使用 DNS-01 验证。</span></label><label>DNS 服务商<select @bind="form.DnsProviderAccountId"><option value="">不使用</option>@foreach (var p in providers) { <option value="@p.Id">@p.Name (@p.Type)</option> }</select><span class="field-help">DNS-01 验证时请选择已启用的服务商。</span></label><label class="check"><input type="checkbox" @bind="form.AutoRenew" />自动续期<span>证书接近到期时自动尝试续期。</span></label><label class="check"><input type="checkbox" @bind="form.Enabled" />启用域名<span>启用后才可申请与自动续期。</span></label></div><div class="form-actions"><button type="submit">保存域名</button></div>@if (form.ChallengeType == ChallengeType.Http01 && (form.PrimaryDomain.StartsWith("*.", StringComparison.Ordinal) || form.Sans.Contains("*."))) { <p class="error">通配符域名必须选择 DNS-01。</p> }@if (!string.IsNullOrEmpty(message)) { <p class="notice">@message</p> }</EditForm>
<section class="panel"><div class="panel-heading"><div><h3>已配置域名</h3><p>共 @domains.Count 个域名</p></div></div>@if (domains.Count == 0) { <div class="empty-state compact"><strong>尚未配置域名</strong><p>填写上方表单，保存后即可开始申请证书。</p></div> } else { <div class="table-wrap"><table><thead><tr><th>域名</th><th>验证方式</th><th>DNS 服务商</th><th>状态</th><th>自动续期</th><th>操作</th></tr></thead><tbody>@foreach (var item in domains) { var hasSans = !string.IsNullOrWhiteSpace(item.Sans); var isExpanded = expandedDomainIds.Contains(item.Id); <tr><td>@if (hasSans) { <button type="button" class="expand-toggle" aria-expanded="@isExpanded" @onclick="() => ToggleSans(item.Id)"><span aria-hidden="true">@(isExpanded ? "▾" : "▸")</span>@item.PrimaryDomain</button> } else { @item.PrimaryDomain }</td><td>@item.ChallengeType</td><td>@(item.DnsProviderAccount?.Name ?? "未配置")</td><td>@(item.Enabled ? "启用" : "禁用")</td><td>@(item.AutoRenew ? "已开启" : "已关闭")</td><td><button type="button" @onclick="() => IssueAsync(item.Id)">立即申请</button><button type="button" class="secondary" @onclick="() => ToggleEnabledAsync(item)">@(item.Enabled ? "禁用" : "启用")</button><button type="button" class="secondary" @onclick="() => ToggleAutoRenewAsync(item)">@(item.AutoRenew ? "关闭续期" : "开启续期")</button></td></tr>@if (isExpanded) { <tr class="expanded-row"><td colspan="6"><strong>SAN</strong><ul class="san-list">@foreach (var san in item.Sans.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <li>@san</li> }</ul></td></tr> } }</tbody></table></div> }</section>

@code { private List<DomainEntity> domains = []; private List<DnsProviderAccount> providers = []; private readonly HashSet<int> expandedDomainIds = []; private DomainEntity form = new(); private string? message; protected override async Task OnInitializedAsync() { await LoadAsync(); } private async Task LoadAsync() { domains = await Service.ListAsync(); providers = await Providers.ListAsync(); } private void ToggleSans(int id) { if (!expandedDomainIds.Add(id)) expandedDomainIds.Remove(id); } private async Task SaveAsync() { try { await Service.SaveAsync(form); message = "保存成功"; form = new DomainEntity(); await LoadAsync(); } catch (Exception ex) { message = ex.Message; } } private async Task ToggleEnabledAsync(DomainEntity item) { try { await Service.SetEnabledAsync(item.Id, !item.Enabled); await LoadAsync(); } catch (Exception ex) { message = ex.Message; } } private async Task ToggleAutoRenewAsync(DomainEntity item) { try { await Service.SetAutoRenewAsync(item.Id, !item.AutoRenew); await LoadAsync(); } catch (Exception ex) { message = ex.Message; } } private async Task IssueAsync(int id) { try { var certificate = await Certificates.RequestAsync(id); Navigation.NavigateTo($"/logs?certificateId={certificate.Id}"); } catch (Exception ex) { message = ex.Message; } } }
