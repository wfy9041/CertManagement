@page "/domains"
@attribute [Authorize]
@inject DomainService Service
@inject DnsProviderService Providers
@inject CertificateService Certificates
@using DomainEntity = CertManagement.Domain.Domain

<PageTitle>域名管理</PageTitle>
<div class="page-heading"><div><p class="eyebrow">域名服务</p><h2>域名管理</h2><p class="subtitle">配置申请域名、验证方式与自动续期策略</p></div></div>
<EditForm Model="form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="form-grid"><label>主域名<input @bind="form.PrimaryDomain" placeholder="example.com 或 *.example.com" /></label><label>SAN（每行一个）<textarea @bind="form.Sans"></textarea></label><label>验证方式<select @bind="form.ChallengeType"><option value="Http01">HTTP-01</option><option value="Dns01">DNS-01</option></select></label><label>DNS 服务商<select @bind="form.DnsProviderAccountId"><option value="">不使用</option>@foreach (var p in providers) { <option value="@p.Id">@p.Name (@p.Type)</option> }</select></label><label class="check"><input type="checkbox" @bind="form.AutoRenew" />自动续期</label><label class="check"><input type="checkbox" @bind="form.Enabled" />启用域名</label></div><button type="submit">保存域名</button>@if (form.ChallengeType == ChallengeType.Http01 && (form.PrimaryDomain.StartsWith("*.", StringComparison.Ordinal) || form.Sans.Contains("*."))) { <p class="error">通配符域名必须选择 DNS-01。</p> }@if (!string.IsNullOrEmpty(message)) { <p class="notice">@message</p> }</EditForm>
<section class="panel"><div class="panel-heading"><div><h3>已配置域名</h3><p>共 @domains.Count 个域名</p></div></div><div class="table-wrap"><table><thead><tr><th>域名</th><th>验证方式</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var item in domains) { <tr><td>@item.PrimaryDomain<br /><small>@item.Sans</small></td><td>@item.ChallengeType</td><td>@(item.Enabled ? "启用" : "禁用")</td><td><button @onclick="() => IssueAsync(item.Id)">立即申请</button><button class="secondary" @onclick="() => ToggleAsync(item)">@(item.Enabled ? "禁用" : "启用")</button></td></tr> }</tbody></table></div></section>

@code { private List<DomainEntity> domains = []; private List<DnsProviderAccount> providers = []; private DomainEntity form = new(); private string? message; protected override async Task OnInitializedAsync() { await LoadAsync(); } private async Task LoadAsync() { domains = await Service.ListAsync(); providers = await Providers.ListAsync(); } private async Task SaveAsync() { try { await Service.SaveAsync(form); message = "保存成功"; form = new DomainEntity(); await LoadAsync(); } catch (Exception ex) { message = ex.Message; } } private async Task ToggleAsync(DomainEntity item) { await Service.SetEnabledAsync(item.Id, !item.Enabled); await LoadAsync(); } private async Task IssueAsync(int id) { try { await Certificates.RequestAsync(id); message = "申请已完成"; } catch (Exception ex) { message = ex.Message; } } }