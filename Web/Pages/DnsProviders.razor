@page "/dns-providers"
@attribute [Authorize]
@inject DnsProviderService Service

<PageTitle>DNS 服务商</PageTitle>
<div class="page-heading"><div><p class="eyebrow">DNS 服务</p><h2>DNS 服务商</h2><p class="subtitle">管理 DNS-01 验证所需的服务商凭据</p></div></div>
<p class="notice">密钥使用 ASP.NET Core Data Protection 加密保存，页面不会回显已保存密钥。</p><EditForm Model="form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="form-grid"><label>名称<input @bind="form.Name" /></label><label>类型<select @bind="form.Type"><option value="Cloudflare">Cloudflare</option><option value="Aliyun">阿里云</option></select></label><label>API Key / Token<input type="password" @bind="apiKey" /></label><label>Secret<input type="password" @bind="secret" /></label><label class="check"><input type="checkbox" @bind="form.Enabled" />启用</label></div><button type="submit">保存服务商</button>@if (!string.IsNullOrEmpty(message)) { <p class="notice">@message</p> }</EditForm>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>名称</th><th>类型</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var p in items) { <tr><td>@p.Name</td><td>@p.Type</td><td>@(p.Enabled ? "启用" : "禁用")</td><td><button class="secondary" @onclick="() => TestAsync(p.Id)">测试连接</button></td></tr> }</tbody></table></div></section>
@code { private List<DnsProviderAccount> items = []; private DnsProviderAccount form = new(); private string apiKey = string.Empty, secret = string.Empty, message = string.Empty; protected override async Task OnInitializedAsync() => items = await Service.ListAsync(); private async Task SaveAsync() { try { await Service.SaveAsync(form, apiKey, secret); message = "保存成功"; form = new(); apiKey = secret = string.Empty; items = await Service.ListAsync(); } catch (Exception ex) { message = ex.Message; } } private async Task TestAsync(int id) => message = await Service.TestAsync(id) ? "连接成功" : "连接失败"; }