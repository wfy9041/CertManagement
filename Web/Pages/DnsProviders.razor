@page "/dns-providers"
@attribute [Authorize]
@inject DnsProviderService Service
@inject IJSRuntime JS

<PageTitle>DNS 服务商</PageTitle>
<div class="page-heading"><div><h2>DNS 服务商</h2><p class="subtitle">管理 DNS-01 验证所需的服务商凭据</p></div></div>
<section class="panel"><div class="panel-heading"><h3>DNS 服务商列表</h3><button type="button" @onclick="OpenCreateModal">新增 DNS 服务商</button></div>@if (items.Count == 0) { <div class="empty-state compact"><strong>尚未配置 DNS 服务商</strong><p>若需要 DNS-01 验证或通配符证书，请点击右上角新增服务商凭据。</p></div> } else { <div class="table-wrap"><table><thead><tr><th>名称</th><th>类型</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var p in items) { <tr><td>@p.Name</td><td>@GetProviderLabel(p.Type)</td><td><label class="switch"><input type="checkbox" checked="@p.Enabled" @onchange="() => ToggleEnabledAsync(p)" /><span></span></label></td><td><button class="secondary" @onclick="() => TestAsync(p.Id)">测试连接</button><button class="secondary" @onclick="() => OpenEditModal(p)">修改</button> <button type="button" class="secondary" @onclick="() => DeleteAsync(p)">删除</button></td></tr> }</tbody></table></div> }</section>@if (!string.IsNullOrEmpty(message)) { <p class="notice">@message</p> }@if (showCreateModal) { <div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="create-provider-title"><div class="modal-heading"><h3 id="create-provider-title">@(form.Id == 0 ? "新增 DNS 服务商" : "修改 DNS 服务商")</h3><button type="button" class="modal-close" aria-label="关闭" @onclick="CloseCreateModal">×</button></div><EditForm Model="form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="form-grid modal-form-grid"><label>名称<input @bind="form.Name" placeholder="例如：生产环境 Cloudflare" /><span class="field-help">用于在域名配置中识别此服务商凭据。</span></label><label>类型<select @bind="form.Type" @bind:after="OnTypeChanged"><option value="Cloudflare">Cloudflare</option><option value="Aliyun">阿里云 DNS（AliDNS）</option><option value="AliyunEsa">阿里云 ESA</option></select><span class="field-help">请选择托管待验证域名的 DNS 服务商。ESA 仅支持已激活的 NS 托管站点；CNAME 接入请选权威 DNS 服务商。</span></label>
@if (form.Id == 0)
{
    <label>凭据来源
        <select @bind="credentialSourceId">
            <option value="0">手动输入</option>
            @foreach (var source in items.Where(x => x.Type == form.Type && !string.IsNullOrWhiteSpace(x.ProtectedApiKeyOrToken) && !string.IsNullOrWhiteSpace(x.ProtectedSecret)))
            {
                <option value="@source.Id">@($"{source.Name}（#{source.Id}）")</option>
            }
        </select>
    </label>
}
@if (credentialSourceId == 0)
{
    <label>@(form.Type == DnsProviderType.Cloudflare ? "API Key / Token" : "AccessKeyId")<input type="password" @bind="apiKey" autocomplete="off" placeholder="@(form.Id == 0 ? (form.Type == DnsProviderType.Cloudflare ? "请输入 API Key 或 Token" : "请输入 AccessKeyId") : "留空保持原值")" /><span class="field-help">阿里云 DNS / ESA 请填写 AccessKeyId 和 AccessKeySecret；ESA 需具备站点查询及 DNS 记录管理权限。</span><span class="field-help">密钥使用 ASP.NET Core Data Protection 加密保存，页面不会回显已保存密钥。</span></label><label>@(form.Type == DnsProviderType.Cloudflare ? "Secret" : "AccessKeySecret")<input type="password" @bind="secret" autocomplete="off" placeholder="@(form.Id == 0 ? (form.Type == DnsProviderType.Cloudflare ? "如服务商要求，请填写 Secret" : "请输入 AccessKeySecret") : "留空保持原值")" /><span class="field-help">保存后不会回显；编辑时留空将保持原值。</span><span class="field-help">密钥使用 ASP.NET Core Data Protection 加密保存，页面不会回显已保存密钥。</span></label>
}
<label class="check"><input type="checkbox" @bind="form.Enabled" />启用<span>启用后可用于 DNS-01 域名验证。</span></label></div>@if (!string.IsNullOrEmpty(createMessage)) { <p class="notice">@createMessage</p> }<div class="form-actions modal-actions"><button type="button" class="secondary" @onclick="CloseCreateModal">取消</button><button type="submit">保存服务商</button></div></EditForm></section></div> }
@if (showTestModal) { <div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="test-provider-title"><div class="modal-heading"><h3 id="test-provider-title">测试连接</h3><button type="button" class="modal-close" aria-label="关闭" @onclick="CloseTestModal">×</button></div><p class="notice @(testSucceeded ? "success" : "error")">@testMessage</p><div class="form-actions modal-actions"><button type="button" @onclick="CloseTestModal">确定</button></div></section></div> }
@code { private List<DnsProviderAccount> items = []; private DnsProviderAccount form = new(); private string apiKey = string.Empty, secret = string.Empty, message = string.Empty, createMessage = string.Empty, testMessage = string.Empty; private bool showCreateModal, showTestModal, testSucceeded; protected override async Task OnInitializedAsync() => items = await Service.ListAsync(); private void OpenCreateModal() { form = new DnsProviderAccount(); credentialSourceId = 0; apiKey = secret = createMessage = string.Empty; showCreateModal = true; } private void OpenEditModal(DnsProviderAccount item) { form = new DnsProviderAccount { Id = item.Id, Name = item.Name, Type = item.Type, Enabled = item.Enabled }; apiKey = secret = createMessage = string.Empty; showCreateModal = true; } private void CloseCreateModal() { form = new DnsProviderAccount(); credentialSourceId = 0; apiKey = secret = createMessage = string.Empty; showCreateModal = false; } private void CloseTestModal() { testMessage = string.Empty; showTestModal = false; } private async Task SaveAsync() { try { var editing = form.Id != 0; await Service.SaveAsync(form, apiKey, secret, credentialSourceId: credentialSourceId); message = editing ? "修改成功" : "新增成功"; items = await Service.ListAsync(); CloseCreateModal(); } catch (Exception ex) { createMessage = ex.Message; } } private async Task TestAsync(int id) { try { testSucceeded = await Service.TestAsync(id); testMessage = testSucceeded ? "连接成功" : "连接失败"; } catch (Exception ex) { testSucceeded = false; testMessage = $"连接失败：{ex.Message}"; } showTestModal = true; } }
