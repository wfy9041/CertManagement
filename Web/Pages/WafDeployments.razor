@page "/waf-deployments"
@attribute [Authorize]
@inject WafDeploymentService Service
@inject DomainService Domains
@inject CertificateService Certificates
@inject IJSRuntime JS
@using WafDeploymentTarget = CertManagement.Domain.DeploymentTarget
@implements IAsyncDisposable
<PageTitle>部署目标</PageTitle>
<div class="page-heading"><div><h2>部署目标</h2><p class="subtitle">管理不同类型的证书部署目标</p></div></div>
<section class="panel"><div class="panel-heading"><h3>部署目标列表</h3><button type="button" @onclick="OpenCreateModal">新增部署目标</button></div><div class="table-wrap"><table><thead><tr><th>域名</th><th>类型</th><th>目标域名</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach (var item in targets) { var certificateId = issuedCertificateIdsByDomain.GetValueOrDefault(item.DomainId); <tr><td>@item.Domain?.PrimaryDomain</td><td>@GetDeploymentTypeLabel(item.Type)</td><td>@item.WafDomain</td><td><label class="switch"><input type="checkbox" checked="@item.Enabled" @onchange="() => ToggleEnabledAsync(item)" /><span></span><em>@(item.Enabled ? "启用" : "禁用")</em></label></td><td><button class="secondary" @onclick="() => TestAsync(item.Id)">测试连接</button><button class="secondary" @onclick="() => OpenEditModal(item)">修改</button>@if (certificateId != 0) { <button class="secondary" disabled="@(!item.Enabled)" @onclick="() => DeployAsync(certificateId, item.Id)">手动部署</button> }</td></tr> }</tbody></table></div></section>
<section class="panel"><div class="panel-heading"><h3>最近部署记录</h3><p>向下滚动加载更早记录</p></div><div class="log-scroll" @ref="scrollContainer"><table class="log-table"><thead><tr><th class="log-domain">域名</th><th class="log-type">类型</th><th class="log-status">状态</th><th class="log-time">时间</th><th>证书 ID</th><th>错误</th></tr></thead><tbody>@foreach (var item in deployments) { <tr><td class="log-domain">@item.Certificate.PrimaryDomain</td><td class="log-type">@GetDeploymentTypeLabel(item.DeploymentTarget?.Type)</td><td class="log-status">@item.Status</td><td class="log-time">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td>@(item.EsaCertificateId ?? item.ProviderCertificateId?.ToString() ?? "—")</td><td class="log-message">@item.ErrorMessage</td></tr> }</tbody></table>@if (isLoadingMore) { <p class="log-loading">正在加载…</p> } else if (!hasMore && deployments.Count > 0) { <p class="log-loading">已加载全部记录</p> }</div></section>
@if (!string.IsNullOrWhiteSpace(message)) { <p class="notice">@message</p> }
@if (showCreateModal) { <div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="create-deployment-title"><div class="modal-heading"><h3 id="create-deployment-title">@(form.Id == 0 ? "新增部署目标" : "修改部署目标")</h3><button type="button" class="modal-close" aria-label="关闭" @onclick="CloseCreateModal">×</button></div><EditForm Model="form" OnValidSubmit="SaveAsync"><div class="form-grid modal-form-grid"><label>所属域名<select @bind="form.DomainId"><option value="0">请选择域名</option>@foreach (var d in domains) { <option value="@d.Id">@d.PrimaryDomain</option> }</select></label><label>类型<select @bind="form.Type" @bind:after="OnTypeChanged"><option value="Waf">阿里云WAF2.0</option><option value="Esa">阿里云 ESA</option></select></label><label>名称<input @bind="form.Name" /></label><label>目标域名<input @bind="form.WafDomain" placeholder="@(form.Type == DeploymentTargetType.Esa ? "ESA 站点下由证书覆盖的域名" : "WAF 中已接入的域名")" /></label>
@if (form.Id == 0)
{
    <label>凭据来源
        <select @bind="credentialSourceId">
            <option value="0">手动输入</option>
            @foreach (var source in targets.Where(x => x.Type == form.Type && !string.IsNullOrWhiteSpace(x.AccessKeyId) && !string.IsNullOrWhiteSpace(x.ProtectedAccessKeySecret)))
            {
                <option value="@source.Id">@($"{source.Name}（#{source.Id}）")</option>
            }
        </select>
    </label>
}
@if (credentialSourceId == 0)
{
    <label>AccessKeyId<input @bind="form.AccessKeyId" /></label><label>AccessKeySecret<input type="password" @bind="secret" autocomplete="off" placeholder="@(form.Id == 0 ? "请输入 AccessKeySecret" : "留空保持原值")" /></label>
}
<label>@(form.Type == DeploymentTargetType.Esa ? "SiteId" : "InstanceId")<input @bind="form.InstanceId" /></label>@if (form.Type == DeploymentTargetType.Esa) { <label>Endpoint<select @bind="form.Endpoint"><option value="esa.cn-hangzhou.aliyuncs.com">杭州（中国站账号）</option><option value="esa.ap-southeast-1.aliyuncs.com">新加坡（国际站账号）</option></select></label><p class="field-help">需要 esa:GetSite 和 esa:SetCertificate 权限。首次部署上传证书，续签后更新已保存的证书 ID。测试连接只查询站点。</p>@if (!string.IsNullOrEmpty(form.EsaCertificateId)) { <label>ESA 证书 ID<input value="@form.EsaCertificateId" readonly /></label> } } else { <label>Endpoint<input @bind="form.Endpoint" /></label> }</div>@if (!string.IsNullOrWhiteSpace(createMessage)) { <p class="notice">@createMessage</p> }<div class="form-actions modal-actions"><button type="button" class="secondary" @onclick="CloseCreateModal">取消</button><button type="submit">保存部署目标</button></div></EditForm></section></div> }
@if (showTestModal) { <div class="modal-backdrop"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="test-deployment-title"><div class="modal-heading"><h3 id="test-deployment-title">测试连接</h3><button type="button" class="modal-close" aria-label="关闭" @onclick="CloseTestModal">×</button></div><p class="notice">@testMessage</p><div class="form-actions modal-actions"><button type="button" @onclick="CloseTestModal">确定</button></div></section></div> }
@code { private WafDeploymentTarget form = new(); private string secret = string.Empty; private List<WafDeploymentTarget> targets = []; private List<CertificateDeployment> deployments = []; private List<CertManagement.Domain.Domain> domains = []; private Dictionary<int, int> issuedCertificateIdsByDomain = []; private ElementReference scrollContainer; private DotNetObjectReference<WafDeployments>? dotNetReference; private bool hasMore; private bool isLoadingMore; private bool scrollObserved; private bool showCreateModal, showTestModal; private string? message; private string? createMessage; private string testMessage = string.Empty; protected override async Task OnInitializedAsync() { domains = await Domains.ListAsync(); await LoadAsync(); } private async Task LoadAsync() { targets = await Service.ListTargetsAsync(); deployments = await Service.ListDeploymentsAsync(take: 30); hasMore = deployments.Count == 30; issuedCertificateIdsByDomain = (await Certificates.ListAsync()).Where(x => x.Status == CertificateStatus.Issued).ToDictionary(x => x.DomainId, x => x.Id); } private void OpenCreateModal() { form = new WafDeploymentTarget(); credentialSourceId = 0; secret = string.Empty; createMessage = null; showCreateModal = true; } private void OpenEditModal(WafDeploymentTarget item) { form = new WafDeploymentTarget { Id = item.Id, DomainId = item.DomainId, Type = item.Type, Name = item.Name, AccessKeyId = item.AccessKeyId, InstanceId = item.InstanceId, WafDomain = item.WafDomain, Endpoint = item.Endpoint, EsaCertificateId = item.EsaCertificateId, Enabled = item.Enabled }; secret = string.Empty; createMessage = null; showCreateModal = true; } private void CloseCreateModal() { form = new WafDeploymentTarget(); credentialSourceId = 0; secret = string.Empty; createMessage = null; showCreateModal = false; } private void CloseTestModal() { testMessage = string.Empty; showTestModal = false; } private async Task SaveAsync() { try { var editing = form.Id != 0; await Service.SaveTargetAsync(form, secret, credentialSourceId: credentialSourceId); message = editing ? "修改成功" : "新增成功"; await LoadAsync(); CloseCreateModal(); } catch (Exception ex) { createMessage = ex.Message; } } private async Task ToggleEnabledAsync(WafDeploymentTarget item) { try { await Service.SetEnabledAsync(item.Id, !item.Enabled); await LoadAsync(); } catch (Exception ex) { message = ex.Message; } } private async Task TestAsync(int id) { try { testMessage = await Service.TestAsync(id) ? "连接成功" : "连接失败"; } catch (Exception ex) { testMessage = ex.Message; } showTestModal = true; } private async Task DeployAsync(int certificateId, int targetId) { try { await Service.DeployAsync(certificateId, targetId); message = "部署已完成，请查看最新记录。"; await LoadAsync(); } catch (Exception ex) { message = ex.Message; } } private static string GetDeploymentTypeLabel(DeploymentTargetType? type) => type switch { DeploymentTargetType.Waf => "阿里云WAF2.0", DeploymentTargetType.Esa => "阿里云 ESA", _ => type?.ToString() ?? "—" }; [JSInvokable] public async Task LoadMoreAsync() { if (isLoadingMore || !hasMore || deployments.Count == 0) return; isLoadingMore = true; try { var more = await Service.ListDeploymentsAsync(deployments[^1].Id, 30); deployments.AddRange(more); hasMore = more.Count == 30; } finally { isLoadingMore = false; } } protected override async Task OnAfterRenderAsync(bool firstRender) { if (!scrollObserved) { dotNetReference = DotNetObjectReference.Create(this); await JS.InvokeVoidAsync("certManagement.observeScroll", scrollContainer, dotNetReference); scrollObserved = true; } } public async ValueTask DisposeAsync() { if (scrollObserved) await JS.InvokeVoidAsync("certManagement.unobserveScroll", scrollContainer); dotNetReference?.Dispose(); } }
