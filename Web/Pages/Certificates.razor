@page "/certificates"
@attribute [Authorize]
@inject IJSRuntime JS
@inject CertificateService Service
@inject CertificateRequestQueue CertificateRequests
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<RenewalOptions> RenewalOptions

<PageTitle>证书管理</PageTitle>
<div class="page-heading"><div><h2>证书管理</h2><p class="subtitle">查看证书状态、下载文件或手动发起续期</p></div></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>域名</th><th>状态</th><th>签发时间</th><th>过期时间</th><th>剩余天数</th><th>自动续期</th><th>证书文件</th><th>操作</th></tr></thead><tbody>@foreach (var c in items) { <tr><td>@c.PrimaryDomain</td><td>@c.Status</td><td>@c.IssuedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td class="@(IsExpiring(c.ExpiresAt) ? "expiry-warning" : null)">@c.ExpiresAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td>@(c.ExpiresAt is null ? "-" : Math.Max(0, (c.ExpiresAt.Value - DateTime.UtcNow).Days))</td><td>@(c.AutoRenew ? "是" : "否")</td><td>@if (c.Status == CertificateStatus.Issued) { <span class="certificate-downloads"><a href="/api/certificates/@c.Id/download/bundle">下载证书包</a></span> }</td><td><button @onclick="() => RenewAsync(c.DomainId, c.Status == CertificateStatus.Issued)">@(c.Status == CertificateStatus.Failed ? "重新申请" : "立即续期")</button> <button type="button" class="secondary" @onclick="() => DeleteAsync(c)">删除</button></td></tr> }</tbody></table></div></section>@if (!string.IsNullOrEmpty(message)) { <p class="notice">@message</p> }
@code { private List<Certificate> items = []; private string? message; private bool IsExpiring(DateTime? expiresAt) => expiresAt is not null && expiresAt < DateTime.UtcNow.AddDays(RenewalOptions.Value.RenewBeforeDays); protected override async Task OnInitializedAsync() => items = await Service.ListAsync(); private async Task RenewAsync(int domainId, bool renewal) { try { var certificate = await Service.StartAsync(domainId, renewal); await CertificateRequests.EnqueueAsync(new CertificateRequest(certificate.Id, renewal)); Navigation.NavigateTo($"/logs?certificateId={certificate.Id}"); } catch (Exception ex) { message = ex.Message; } } }

@code {
    private async Task DeleteAsync(Certificate certificate)
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("confirm",
                $"确定删除“{certificate.PrimaryDomain}”的证书记录？申请订单、日志和部署历史也会一并删除。磁盘证书文件和云端已部署的证书将保留。"))
                return;

            await Service.DeleteAsync(certificate.Id);
            message = "证书记录已删除。";
            items = await Service.ListAsync();
        }
        catch (Exception ex) { message = ex.Message; }
    }
}
