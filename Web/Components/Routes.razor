@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using CertManagement.Web.Layout
@using CertManagement.Web.Pages

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <LayoutView Layout="@typeof(MainLayout)"><p>请先登录。<a href="/login">登录</a></p></LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound><LayoutView Layout="@typeof(MainLayout)"><p>页面不存在。</p></LayoutView></NotFound>
</Router>
