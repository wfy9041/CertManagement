@inject NavigationManager Navigation
@implements IDisposable

<nav>
    <a href="/" class="@HomeClass">概览</a>
    <a href="/domains" class="@DomainsClass">域名管理</a>
    <a href="/certificates" class="@CertificatesClass">证书管理</a>
    <a href="/waf-deployments" class="@WafClass">部署目标</a>
    <a href="/dns-providers" class="@DnsProvidersClass">DNS 服务商</a>
    <a href="/logs" class="@LogsClass">申请日志</a>
    <a href="/settings" class="@SettingsClass">系统设置</a>
</nav>
<AuthorizeView><Authorized><div class="sidebar-user-menu"><span>@context.User.Identity?.Name</span><a href="/api/auth/logout">退出登录</a></div></Authorized></AuthorizeView>

@code {
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private string HomeClass => GetActiveClass("/");
    private string DomainsClass => GetActiveClass("/domains");
    private string CertificatesClass => GetActiveClass("/certificates");
    private string WafClass => GetActiveClass("/waf-deployments");
    private string DnsProvidersClass => GetActiveClass("/dns-providers");
    private string LogsClass => GetActiveClass("/logs");
    private string SettingsClass => GetActiveClass("/settings");

    private string GetActiveClass(string href) => string.Equals(new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/'), href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;

    private void OnLocationChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
